      "item": [
        {
          "name": "Register User - Happy Path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "pm.test('Response contains token and user object', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData).to.have.property('user');",
                  "    pm.expect(jsonData.user).to.have.property('id');",
                  "    pm.environment.set('authToken', jsonData.token);",
                  "    pm.environment.set('userId', jsonData.user.id);",
                  "    pm.environment.set('username', jsonData.user.username);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Scholar\",\n  \"email\": \"scholar_test_1788108577465@scholarquest.dev\",\n  \"phone\": \"+1234567890\",\n  \"username\": \"scholar_52298\",\n  \"password\": \"Password123!\"\n}"
