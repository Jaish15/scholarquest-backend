# Environment Variables for ScholarQuest Backend

# Server
PORT=3000
FRONTEND_URL=http://localhost:5500

# JWT Secret — CHANGE THIS IN PRODUCTION!
JWT_SECRET=scholarquest_secret_change_in_prod

# ── Neon PostgreSQL Database ────────────────────────────────────
DATABASE_URL="postgresql://neondb_owner:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=production
