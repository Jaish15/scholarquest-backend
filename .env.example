# Environment Variables for ScholarQuest Backend

# Server
PORT=3000
FRONTEND_URL=http://localhost:5500

# JWT Secret — CHANGE THIS IN PRODUCTION!
JWT_SECRET=scholarquest_secret_change_in_prod

# ── MongoDB (for future migration) ─────────────────────────────
# Uncomment and fill when switching from JSON file storage:
# MONGO_URI=mongodb://localhost:27017/scholarquest
# Or for MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/scholarquest
